{
  "manifest_version": 3,
  "name": "Piper Neural Text-to-Speech",
  "version": "1.0.0",
  "description": "Read aloud selected text with Piper Neural TTS, auto Hindi/English language detection, mouse speed scrubbing, and cursor hover-to-seek.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Piper Neural TTS Settings"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "offscreen",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.huggingface.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*",
        "offscreen/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
