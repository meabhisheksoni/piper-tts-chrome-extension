{
  "manifest_version": 3,
  "name": "Piper & Kokoro Neural Text-to-Speech",
  "version": "1.2.0",
  "description": "Read aloud selected text with Google Gemini 3.8 AI & Kokoro-82M Studio Neural Voice, 100% offline local engine, auto Hindi/English language detection, smart AI summarization, mouse speed scrubbing, and hover-to-seek.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Piper & Kokoro Neural TTS Settings"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "offscreen",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.huggingface.co/*",
    "https://cdn.jsdelivr.net/*",
    "https://rhasspy.github.io/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/gemini-api.js",
        "content/content-script.js"
      ],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*",
        "offscreen/*",
        "lib/*",
        "lib/kokoro/*",
        "lib/kokoro/voices/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
